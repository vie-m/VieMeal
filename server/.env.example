# Copy this file to .env and fill in your values.

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# (docker-compose uses port 5433 so it does not clash with another local Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/viemeal

PORT=4100

# Any long random string. Used to sign login tokens (JWT).
JWT_SECRET=change-me-to-a-long-random-string

# Frontend address (for CORS). Comma-separate several.
CLIENT_ORIGIN=http://localhost:5174

# ---- AI (optional) ----
# Leave AI_API_KEY empty to run without AI: the app still works, only the
# AI chat and AI explanations are switched off.
# AI_PROVIDER: gemini | openai | anthropic
AI_PROVIDER=gemini
AI_API_KEY=
# Examples: gemini-3.5-flash | gpt-4o-mini | claude-3-5-haiku-latest
AI_MODEL=gemini-3.5-flash
# Optional: custom OpenAI-compatible base URL (e.g. a local proxy)
AI_BASE_URL=
# Max AI requests per user per hour
AI_RATE_LIMIT_PER_HOUR=20
